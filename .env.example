# Local dev database (docker compose up -d). On Vercel set DATABASE_URL to the POOLED Neon URL (-pooler).
DATABASE_URL=postgres://mebudget:mebudget@localhost:5432/mebudget

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Single user. Generate the hash with `pnpm auth:hash` (hidden prompt, min 12 chars)
AUTH_EMAIL=you@example.com
AUTH_PASSWORD_HASH=
# Optional extra accounts that may log in (they all see the same data): email|hash;email2|hash2
AUTH_EXTRA_USERS=

# Gemini (server only, never expose to the client)
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
