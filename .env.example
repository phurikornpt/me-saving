# Local dev database (docker compose up -d). On Vercel set DATABASE_URL to the POOLED Neon URL (-pooler).
DATABASE_URL=postgres://mebudget:mebudget@localhost:5432/mebudget

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Accounts live in the database: add one with `pnpm user:add` (hidden password prompt, min 12 chars).
# The three AUTH_* below are only read once, by migration 005-users, on a database from before accounts
# existed: everything recorded so far goes to AUTH_EMAIL, and each AUTH_EXTRA_USERS entry (email|hash;...)
# becomes a separate, empty account. A fresh setup can leave them empty.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_EXTRA_USERS=

# Optional daily receipt-scan limit per account (e.g. 20). Empty = scans are counted but never blocked.
RECEIPT_SCAN_DAILY_LIMIT=

# Gemini (server only, never expose to the client)
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
