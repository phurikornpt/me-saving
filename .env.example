# Local dev database (docker compose up -d)
DATABASE_URL=postgres://mebudget:mebudget@localhost:5432/mebudget

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Single user. Generate the hash with: pnpm tsx scripts/hash-password.ts '<password>'
AUTH_EMAIL=you@example.com
AUTH_PASSWORD_HASH=

# Gemini (server only, never expose to the client)
GEMINI_API_KEY=
